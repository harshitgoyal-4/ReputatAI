# Free/local mode (default): makes no external API calls.
ANALYZER_MODE=mock

# NVIDIA hosted NIM mode. Do not commit a real .env file.
LLM_PROVIDER=nvidia
NVIDIA_API_KEY="your_nvidia_api_key_here"
NVIDIA_MODEL="nvidia/nemotron-3.5-lightning-30b-a3b"
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Reasoning is disabled for concise, structured review classification.
# Leave empty to process every valid review.
MAX_REVIEWS=
